# Development is explicit. Production requires DATABASE_URL, a session/signing secret,
# external object storage and TLS; this local server refuses production mode.
FIRSTTRY_LOCAL=1
API_PORT=3001
# Leave unset for persistent embedded PostgreSQL (PGlite) under .local/.
# DATABASE_URL=postgresql://firsttry:local-firsttry@localhost:5432/firsttry
WEB_ORIGIN=http://localhost:3000
# Optional real S3-compatible local object storage (requires MinIO running).
# FIRSTTRY_STORAGE=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=firsttry-bundles
# S3_ACCESS_KEY=firsttry-local
# S3_SECRET_KEY=local-firsttry-storage
